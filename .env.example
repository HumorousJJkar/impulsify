# Copy to .env.local (gitignored) and fill in. Restart `npx.cmd expo start` after changing.
# Anything starting with EXPO_PUBLIC_ is baked into the app, so never put the
# Anthropic API key here; that lives only in the backend.

# Your deployed Worker, e.g. https://impulsify-backend.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_URL=

# Same value as APP_KEY in the backend's secrets
EXPO_PUBLIC_APP_KEY=
