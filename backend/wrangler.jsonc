// Cloudflare Worker settings. Secrets (ANTHROPIC_API_KEY, APP_KEY) are NOT here:
// locally they go in .dev.vars (gitignored), in production via `npx wrangler secret put`.
{
  "name": "impulsify-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Rate limit for the AI routes: 10 requests per 60 seconds per person (by IP).
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
